# Required: Google Jules API key (get from https://jules.google/settings)
JULES_API_KEY=

# Optional: encryption key for schedule persistence
# If not set, a key is auto-generated and stored locally
JULES_ENCRYPTION_KEY=

# Optional: allowlist of repos jules_create_session_from_issue may target.
# Comma-separated, supports owner/* and a bare *. Unset means no restriction.
JULES_ALLOWED_REPOS=

# Optional: GitHub token for reading issues (GH_TOKEN and
# GITHUB_PERSONAL_ACCESS_TOKEN are accepted as fallbacks). Unset still works
# for public repos at GitHub's anonymous 60 requests/hour. Read-only is enough.
GITHUB_TOKEN=
