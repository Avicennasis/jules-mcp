# Required: Google Jules API key (get from https://jules.google/settings)
JULES_API_KEY=

# Optional: encryption key for schedule persistence
# If not set, a key is auto-generated and stored locally
JULES_ENCRYPTION_KEY=

# --- Streamable-HTTP transport (opt-in; stdio is the default) ---
# Set JULES_MCP_TRANSPORT=http, or pass --transport http, to enable it.
# There is no unauthenticated mode: without a token the server refuses to start.
# JULES_MCP_TRANSPORT=http
# JULES_MCP_HTTP_TOKEN=          # required for http; `openssl rand -hex 32`
# JULES_MCP_HTTP_HOST=127.0.0.1  # a loopback bind is NOT an auth boundary
# JULES_MCP_HTTP_PORT=9673
# JULES_MCP_HTTP_PATH=/mcp
# JULES_MCP_HTTP_ALLOWED_ORIGINS=  # exact origins, comma separated; '*' refused
# JULES_MCP_HTTP_PROXY_SECRET=     # unset disables the X-Forwarded-User path
# JULES_MCP_HTTP_MAX_BODY_BYTES=1048576
